# Mẫu biến môi trường cho bộ script backup off-site (backlog §6).
# COPY thành `backup.env` (đã nằm trong .gitignore của repo) rồi điền giá trị
# THẬT ở máy/scheduler chạy backup. KHÔNG BAO GIỜ commit file có giá trị.

# Nguồn để dump — chuỗi kết nối PostgreSQL production (CHỈ ĐỌC).
# Script không bao giờ in đầy đủ biến này ra log.
DATABASE_URL=

# Thư mục chứa bản backup cục bộ trước khi đẩy đi.
BACKUP_OUT_DIR=./backups

# --- Kho ngoài: đường TRUNG LẬP NHÀ CUNG CẤP (khuyến nghị) -----------------
# Dự án CHƯA chọn nhà cung cấp. Thay vì ràng vào AWS/B2/GCS/R2, khai một mẫu
# lệnh: `{file}` = đường dẫn cục bộ, `{remote}` = đích đầy đủ (prefix + tên file).
# Bỏ trống BACKUP_UPLOAD_COMMAND = KHÔNG upload, chỉ giữ cục bộ.
#
# Ví dụ (chọn MỘT, chỉ khi đã có credential của CLI tương ứng trên máy chạy):
#   BACKUP_UPLOAD_COMMAND='aws s3 cp {file} {remote}'
#   BACKUP_UPLOAD_COMMAND='rclone copyto {file} {remote}'
#   BACKUP_UPLOAD_COMMAND='b2 file upload my-bucket {file} {remote}'
#
# Script cố ý KHÔNG tự quản lý credential kho lưu trữ — CLI tự đọc từ môi
# trường của máy chạy. KHÔNG đặt secret vào chính biến này.
BACKUP_UPLOAD_COMMAND=

# Tiền tố đích trên kho ngoài. BẮT BUỘC nếu có BACKUP_UPLOAD_COMMAND.
# Ví dụ: s3://ten-bucket/thien-duc/
BACKUP_REMOTE_PREFIX=

# Đặt 1 để chỉ IN ra lệnh sẽ chạy mà không upload thật (diễn tập an toàn).
BACKUP_UPLOAD_DRY_RUN=0

# --- Kho ngoài: đường CŨ theo adapter dựng sẵn (tùy chọn) ------------------
# none | s3 | b2 | gcs. Giữ lại cho cấu hình đã có từ trước; cấu hình mới nên
# dùng BACKUP_UPLOAD_COMMAND ở trên.
BACKUP_DEST=none

# Đích trên kho ngoài, ví dụ: s3://ten-bucket/thien-duc/
BACKUP_DEST_URI=

# Khóa mã hóa đối xứng (gpg AES256). RẤT NÊN đặt khi BACKUP_DEST != none:
# bản dump chứa dữ liệu cá nhân (email/điện thoại người liên hệ). Bỏ trống thì
# script vẫn chạy nhưng in CẢNH BÁO rõ ràng.
BACKUP_ENCRYPT_KEY=

# Chính sách giữ: xóa bản cũ hơn N ngày, nhưng LUÔN giữ ít nhất M bản mới nhất.
# `prune.sh` mặc định CHỈ LIỆT KÊ; phải thêm --apply mới thực sự xóa.
BACKUP_KEEP_DAYS=30
BACKUP_KEEP_MIN=7

# Đích khôi phục thử — BẮT BUỘC localhost và tên DB kết thúc _test/_verify/_restore.
# CỐ Ý không nhúng user/mật khẩu vào đây: để `psql`/`pg_restore` tự lấy từ
# PGUSER/PGPASSWORD hoặc ~/.pgpass. Không đặt credential trong file ví dụ.
VERIFY_DATABASE_URL=postgresql://127.0.0.1:5432/thien_duc_verify
