DATABASE_URL=""
PORT=3001
CORS_ORIGIN="http://localhost:3000"

# JWT
JWT_ACCESS_SECRET="change-me-in-.env"
JWT_ACCESS_EXPIRES_IN="15m"

# Cloudinary 
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Email thông báo form liên hệ — gửi qua Resend HTTPS API 
RESEND_API_KEY=""
# Địa chỉ gửi — phải thuộc domain đã verify ở Resend, hoặc onboarding@resend.dev
# khi test.
MAIL_FROM=""
# Nơi nhận email báo có lead mới. Bắt buộc phải đặt.
CONTACT_NOTIFY_TO=""

# Origin của Admin SPA — dùng dựng link trong email lời mời thiết lập tài khoản
# và email đặt lại mật khẩu (quên mật khẩu).
# Biến KHÔNG bí mật, chỉ ở backend (không thêm tiền tố VITE_/NEXT_PUBLIC_).
# Bắt buộc HTTPS ở production; cho phép http://localhost khi dev/test. Bỏ trống
# hoặc sai định dạng → email lời mời tự bỏ qua (degrade an toàn).
ADMIN_APP_URL="http://localhost:5174"

# --- Tài khoản bootstrap ------------------------------------------------------
# `npm run prisma:seed` (production/staging) gieo MỘT tài khoản từ ADMIN_EMAIL /
# ADMIN_PASSWORD, vai trò lấy từ ADMIN_ROLE (mặc định SUPER_ADMIN).
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
# ADMIN_ROLE="SUPER_ADMIN"   # EDITOR | ADMIN | SUPER_ADMIN

# --- Môi trường E2E (chỉ dùng cục bộ + CI) ------------------------------------
# `npx prisma db seed` (= prisma/seed-e2e.js) gieo HAI tài khoản test và chỉ chạy
# khi DATABASE_URL trỏ localhost/127.0.0.1 + database đúng tên `thien_duc_test`.
# Bộ e2e cần cả hai: app.e2e-spec.ts đăng nhập ADMIN_EMAIL (phải là vai trò
# ADMIN → bài mới ra DRAFT), http-foundation.e2e-spec.ts đăng nhập
# SUPER_ADMIN_EMAIL. Kiểm nhanh hợp đồng env: `npm run e2e:preflight`.
#   NODE_ENV=test
#   MAIL_FAKE_TRANSPORT=1
#   ADMIN_ROLE=ADMIN
#   ADMIN_EMAIL=admin-e2e@test.local
#   ADMIN_PASSWORD=<mật khẩu giả, >= 8 ký tự>
#   SUPER_ADMIN_EMAIL=superadmin-e2e@test.local
#   SUPER_ADMIN_PASSWORD=<mật khẩu giả, >= 8 ký tự>

# Sentry error tracking (task →5) — DSN của project Sentry riêng cho backend.
# Bỏ trống → không init, app chạy bình thường. DSN là khóa ingest-only (không
# đọc được dữ liệu), nhưng theo quy ước vẫn giữ server-side.
SENTRY_DSN=""
